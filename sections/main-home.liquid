<section class="shop-hero">
  <div class="shop-hero-content">
    <h1>{{ shop.name }}</h1>
    <h2>Shop Quality Products Online</h2>
    <p>Discover useful products and enjoy a simple and convenient shopping experience.</p>

    <a href="{{ routes.all_products_collection_url }}" class="shop-button">
      Shop Now
    </a>
  </div>
</section>

<section class="products-section">
  <h2>Featured Products</h2>

  <div class="products-grid">
    {% for product in collections.all.products limit: 12 %}

      <div class="product-card">

        <a href="{{ product.url }}">
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 600 }}"
              alt="{{ product.title | escape }}"
              loading="lazy"
            >
          {% endif %}
        </a>

        <h3>
          <a href="{{ product.url }}">
            {{ product.title }}
          </a>
        </h3>

        <p class="price">
          {{ product.price | money }}
        </p>

        <a href="{{ product.url }}" class="product-button">
          View Product
        </a>

      </div>

    {% else %}

      <p>No products available yet.</p>

    {% endfor %}
  </div>
</section>

<section class="about-section">
  <h2>About Our Store</h2>

  <p>
    Welcome to {{ shop.name }}. We provide quality products
    and a simple shopping experience for our customers.
  </p>
</section>

<style>
.shop-hero {
  background: #222;
  color: white;
  text-align: center;
  padding: 90px 20px;
}

.shop-hero h1 {
  font-size: 42px;
  margin-bottom: 15px;
}

.shop-hero h2 {
  font-size: 32px;
  margin-bottom: 15px;
}

.shop-hero p {
  font-size: 18px;
  max-width: 650px;
  margin: 0 auto 25px;
}

.shop-button,
.product-button {
  display: inline-block;
  background: #00bcd4;
  color: white;
  padding: 12px 22px;
  border-radius: 6px;
  text-decoration: none;
}

.shop-button:hover,
.product-button:hover {
  background: #0097a7;
}

.products-section {
  padding: 60px 20px;
  text-align: center;
}

.products-section h2,
.about-section h2 {
  font-size: 32px;
  margin-bottom: 35px;
}

.products-grid {
  max-width: 1200px;
  margin: auto;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 25px;
}

.product-card {
  background: white;
  padding: 18px;
  border-radius: 10px;
  box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.product-card img {
  width: 100%;
  height: 240px;
  object-fit: cover;
  border-radius: 8px;
}

.product-card h3 {
  margin: 15px 0 8px;
}

.product-card h3 a {
  color: #222;
  text-decoration: none;
}

.price {
  font-weight: bold;
  margin-bottom: 10px;
}

.about-section {
  padding: 60px 20px;
  text-align: center;
  background: #f5f5f5;
}

.about-section p {
  max-width: 700px;
  margin: auto;
}

@media (max-width: 900px) {
  .products-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .products-grid {
    grid-template-columns: 1fr;
  }

  .shop-hero h1 {
    font-size: 32px;
  }

  .shop-hero h2 {
    font-size: 25px;
  }
}
</style>
